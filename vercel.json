{
  "crons": [
    {
      "path": "/api/cron/current-affairs",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/current-jobs",
      "schedule": "30 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/job/:id",
      "destination": "/job.html?id=:id"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/about.html",
      "destination": "/about/index.html"
    },
    {
      "source": "/contact-support",
      "destination": "/contact-support/index.html"
    },
    {
      "source": "/contact-support.html",
      "destination": "/contact-support/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/terms.html",
      "destination": "/terms/index.html"
    }
  ]
}
