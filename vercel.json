{
  "crons": [
    {
      "path": "/api/cron/current-affairs",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/current-jobs",
      "schedule": "30 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ]
}
