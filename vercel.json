{
  "crons": [
    {
      "path": "/api/cron/current-affairs",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/current-jobs",
      "schedule": "0 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/practice",
      "destination": "/practice.html"
    },
    {
      "source": "/practice/",
      "destination": "/practice.html"
    },
    {
      "source": "/daily-quiz",
      "destination": "/daily-quiz.html"
    },
    {
      "source": "/daily-quiz/",
      "destination": "/daily-quiz.html"
    },
    {
      "source": "/mock-tests",
      "destination": "/mock-tests.html"
    },
    {
      "source": "/mock-tests/",
      "destination": "/mock-tests.html"
    },
    {
      "source": "/current-affairs",
      "destination": "/current-affairs.html"
    },
    {
      "source": "/current-affairs/",
      "destination": "/current-affairs.html"
    },
    {
      "source": "/current-jobs",
      "destination": "/current-jobs.html"
    },
    {
      "source": "/current-jobs/",
      "destination": "/current-jobs.html"
    },
    {
      "source": "/books",
      "destination": "/books.html"
    },
    {
      "source": "/books/",
      "destination": "/books.html"
    },
    {
      "source": "/premium",
      "destination": "/premium.html"
    },
    {
      "source": "/premium/",
      "destination": "/premium.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/",
      "destination": "/about.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/disclaimer/",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/previous-year",
      "destination": "/previous-year.html"
    },
    {
      "source": "/previous-year/",
      "destination": "/previous-year.html"
    },
    {
      "source": "/job/:id",
      "destination": "/job.html?id=:id"
    }
  ]
}
